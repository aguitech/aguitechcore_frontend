# Aguitech Core environment template
# Copy to server/.env and fill in real values.
# NEVER commit the real .env (gitignored).

# === Server ===
PORT=4000
NODE_ENV=development

# === Database ===
# Local dev:
MONGO_URI=mongodb://localhost:27017/aguitechcore
# Docker compose / production (replace user/pass + host):
# MONGO_URI=mongodb://USER:PASS@HOST:27017/aguitechcore

# === Auth ===
# Generate a strong secret, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-strong-secret-min-32-chars
JWT_EXPIRES_IN=7d

# === CORS ===
# Comma-separated list of allowed origins
CLIENT_ORIGIN=http://localhost:5173

# === File uploads ===
UPLOAD_MAX_SIZE_MB=50
UPLOAD_DIR=./uploads

# === Optional: WhatsApp Cloud API (for appointment reminders) ===
# WHATSAPP_TOKEN=your-meta-cloud-api-token
# WHATSAPP_PHONE_ID=your-phone-number-id

# === Optional: SMTP (for email notifications) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Aguitech <no-reply@aguitech.com>"

# === Logging ===
LOG_LEVEL=info
